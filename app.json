{
  "expo": {
    "name": "GRIDGO",
    "slug": "gridgo-client",
    "owner": "felyciaaa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gridgoclient",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ph.gridgo.client",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "GRIDGO needs the phone's location to pin the delivery drop-off.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "GRIDGO uses your location only while the app is open, to pin the delivery drop-off. It never follows you in the background.",
        "NSLocationAlwaysUsageDescription": "GRIDGO uses your location only while the app is open, to pin the delivery drop-off. It never follows you in the background.",
        "NSCameraUsageDescription": "GRIDGO does not turn on your camera. Calls with your rider are voice only, and pictures come from your photo library.",
        "NSMotionUsageDescription": "GRIDGO does not read your motion or fitness activity. It only uses your location, while the app is open, to pin the drop-off.",
        "NSFaceIDUsageDescription": "GRIDGO does not use Face ID. Your sign-in stays in the phone's secure storage.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ph.gridgo.client",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Satoshi-Regular.otf",
            "./assets/fonts/Satoshi-Medium.otf",
            "./assets/fonts/Satoshi-Bold.otf",
            "./assets/fonts/Satoshi-Black.otf"
          ]
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#FFDE58"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#111111",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#111111"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "GRIDGO needs your photos so you can set a picture on your account."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "GRIDGO needs photo access so you can save the payment QR.",
          "savePhotosPermission": "GRIDGO needs to save the payment QR to your photos."
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "GRIDGO uses the microphone only while you are on a call with your rider about a delivery."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GRIDGO needs the phone's location to pin the delivery drop-off.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "2c012369-5b00-4454-bf1d-0bbf0d0917d8"
      }
    }
  }
}
